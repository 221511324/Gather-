rules_version = '2';

// Security rules for Gather.
//
// The shape of the app drives these rules: a group session is a document that
// several people write to at once, so the rules have to let a member change
// their own items without letting them touch anyone else's.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && get(/databases/$(database)/documents/users/$(uid())).data.role == 'admin';
    }

    function session(id) {
      return get(/databases/$(database)/documents/sessions/$(id)).data;
    }

    // The catalogue is seeded once, on first sign-in, while `meta/seed` does
    // not yet exist. After that it is admin-only. This gives a one-shot
    // bootstrap window instead of a standing write permission.
    function bootstrapping() {
      return !exists(/databases/$(database)/documents/meta/seed);
    }

    function canManageCatalogue() {
      return signedIn() && (isAdmin() || bootstrapping());
    }

    // ------------------------------------------------------------- users ---
    match /users/{userId} {
      // Fields that decide what a person is allowed to do. Only an
      // administrator may change them — without this, any signed-in user
      // could grant themselves the admin role by editing their own profile.
      function privilegeFields() {
        return request.resource.data.diff(resource.data)
          .affectedKeys().hasAny(['role', 'status']);
      }

      // Any signed-in user can read profiles: members of a session need each
      // other's names, and a host invites people by looking them up.
      allow read: if signedIn();
      allow create: if signedIn() && userId == uid()
        && request.resource.data.role == 'customer';
      allow update: if signedIn()
        && (isAdmin() || (userId == uid() && !privilegeFields()));
      allow delete: if signedIn() && (userId == uid() || isAdmin());

      match /cart/{lineId} {
        allow read, write: if signedIn() && userId == uid();
      }

      match /savedSessions/{savedId} {
        allow read, write: if signedIn() && userId == uid();
      }

      match /paymentMethods/{methodId} {
        allow read, write: if signedIn() && userId == uid();
      }

      match /aiChat/{messageId} {
        allow read, write: if signedIn() && userId == uid();
      }

      match /vouchers/{voucherId} {
        allow read: if signedIn() && (userId == uid() || isAdmin());
        // Admins can grant a reward to someone else (FR32).
        allow write: if signedIn() && (userId == uid() || isAdmin());
      }

      match /notifications/{notificationId} {
        allow read: if signedIn() && userId == uid();
        // Any signed-in user may deliver a notification — that is how invites
        // and session updates reach other members. Only the recipient can
        // mark one read or delete it.
        allow create: if signedIn();
        allow update, delete: if signedIn() && userId == uid();
      }
    }

    // Username uniqueness index. Readable without auth so the sign-up form can
    // check availability before an account exists. Holds only a uid and the
    // handle — never an email address.
    match /usernames/{handle} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow delete: if signedIn()
        && (resource.data.uid == uid() || isAdmin());
      allow update: if false;
    }

    // --------------------------------------------------------- catalogue ---
    match /restaurants/{restaurantId} {
      allow read: if signedIn();
      allow write: if canManageCatalogue();

      match /menu/{itemId} {
        allow read: if signedIn();
        allow write: if canManageCatalogue();
      }
    }

    // Collection-group reads of every restaurant's menu.
    match /{path=**}/menu/{itemId} {
      allow read: if signedIn();
    }

    match /vouchers/{voucherId} {
      allow read: if signedIn();
      allow write: if signedIn() && (isAdmin() || bootstrapping());
    }

    match /meta/{document} {
      allow read: if signedIn();
      allow write: if canManageCatalogue();
    }

    // ---------------------------------------------------------- sessions ---
    // The 4-digit code registry. A user needs to read it to resolve a code
    // into a session, and a host needs to claim and release one.
    match /sessionCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn();
      // Only the host of the session a code points at may release it, so one
      // user cannot free up someone else's live code.
      allow delete: if signedIn()
        && (isAdmin()
            || !exists(/databases/$(database)/documents/sessions/$(resource.data.sessionId))
            || session(resource.data.sessionId).hostId == uid());
      allow update: if false;
    }

    match /sessions/{sessionId} {
      function isMember() {
        return signedIn() && uid() in resource.data.memberIds;
      }
      function isHost() {
        return signedIn() && resource.data.hostId == uid();
      }

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // A user joining is not a member yet. The write is only allowed when it
      // adds exactly their own uid, leaves the rest of the roster intact, and
      // touches nothing but the roster.
      function isSelfJoin() {
        return signedIn()
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && uid() in request.resource.data.memberIds
          && changed().hasOnly(['members', 'memberIds', 'invitedIds', 'updatedAt']);
      }

      // Leaving removes exactly the caller and nobody else.
      function isSelfLeave() {
        return resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && !(uid() in request.resource.data.memberIds)
          && changed().hasOnly(['members', 'memberIds', 'updatedAt']);
      }

      // What an ordinary member is allowed to touch: their own entry in the
      // roster (ready flag, payment status), restaurant suggestions and votes,
      // and the stage — which moves to "choosing a restaurant" the moment
      // anyone suggests one. Everything that decides the order for the whole
      // group — the restaurant, the payment mode, the delivery address, the
      // voucher, the placed order — stays with the host.
      function memberFieldsOnly() {
        return changed().hasOnly(['members', 'suggestions', 'stage', 'updatedAt']);
      }

      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostId == uid();
      allow update: if isAdmin()
        || isHost()
        || isSelfJoin()
        || (isMember() && (memberFieldsOnly() || isSelfLeave()));
      allow delete: if isHost() || isAdmin();

      // The shared cart. Everyone in the session can see every line; only the
      // member who added a line can change it. The host can delete any line,
      // which is what removing a member and switching restaurant rely on.
      match /lines/{lineId} {
        function parent() {
          return session(sessionId);
        }
        // Admins read the shared cart when monitoring a session.
        allow read: if signedIn() && (uid() in parent().memberIds || isAdmin());
        allow create: if signedIn()
          && uid() in parent().memberIds
          && request.resource.data.ownerId == uid();
        allow update: if signedIn() && resource.data.ownerId == uid();
        allow delete: if signedIn()
          && (resource.data.ownerId == uid() || parent().hostId == uid() || isAdmin());
      }
    }

    // ------------------------------------------------------------ orders ---
    match /orders/{orderId} {
      allow read: if signedIn()
        && (uid() in resource.data.participantIds || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == uid();
      // Participants can cancel or review; admins move an order through its
      // delivery states.
      allow update: if signedIn()
        && (uid() in resource.data.participantIds || isAdmin());
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------------- support ---
    match /tickets/{ticketId} {
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
